<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <script src="/js/script.js" defer></script>
  </head>
  <body>
    <h1><%= title %></h1>
    <ul>
    <% posts.forEach(post => { %>
      <li class="post-item">
      
        <a href="/<%= post.id %>"><%= post.title %></a>
      
        <div class="menu-container">
          <button onclick="toggleMenu('<%= post.id %>', event)" class="menu-btn">&vellip;</button>
          <div id="menu-<%= post.id %>"  class="menu hidden-menu">
            <a class="editButton" href="<%= post.id %>/edit">Edit</a>
            <form id="deleteForm" action="/<%= post.id %>/delete" method="POST">
              <button class="deleteButton" type="submit">Delete</button>
            </form>
          </div>
        </div>
      </li>
    <% }) %>
    </ul>

  <form id="postForm" action="/submit" method="POST">
    <input id="postTitle" name="postTitle" placeholder="Title">
    <textarea id="postContent" name="postContent" placeholder="Content"></textarea>
    <!-- <button id="submitPostBtn">Submit</button> -->
    <input type="submit" value="Submit" />
  </form>

  </body>
</html>
